# ------------------------------------------------------------------
# Core — required
# ------------------------------------------------------------------
# Public site URL (no trailing slash). Used for OG images, emails, callbacks.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Postgres connection string (Neon / Supabase / self-hosted)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Better Auth secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# ------------------------------------------------------------------
# Social login (optional — toggle in src/config/website.tsx → auth)
# ------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ------------------------------------------------------------------
# Stripe — payments
# ------------------------------------------------------------------
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_PRO_YEARLY=
NEXT_PUBLIC_STRIPE_PRICE_LIFETIME=

# ------------------------------------------------------------------
# Email — Resend
# ------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=

# ------------------------------------------------------------------
# Storage — S3 compatible (AWS S3 / R2 / MinIO)
# ------------------------------------------------------------------
STORAGE_REGION=auto
STORAGE_BUCKET_NAME=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=
STORAGE_PUBLIC_URL=
STORAGE_FORCE_PATH_STYLE=false

# ------------------------------------------------------------------
# Cron — protects /api/cron/* routes
# ------------------------------------------------------------------
CRON_SECRET=

# ------------------------------------------------------------------
# Analytics (all optional)
# ------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SCRIPT=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT=
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
NEXT_PUBLIC_SELINE_TOKEN=
NEXT_PUBLIC_AHREFS_WEBSITE_ID=
NEXT_PUBLIC_DATAFAST_ANALYTICS_ID=
NEXT_PUBLIC_DATAFAST_ANALYTICS_DOMAIN=

# ------------------------------------------------------------------
# Misc (optional)
# ------------------------------------------------------------------
NEXT_PUBLIC_AFFILIATE_AFFONSO_ID=
NEXT_PUBLIC_AFFILIATE_PROMOTEKIT_ID=
NEXT_PUBLIC_DISCORD_WIDGET_SERVER_ID=
NEXT_PUBLIC_DISCORD_WIDGET_CHANNEL_ID=
NEXT_PUBLIC_DEMO_WEBSITE=false
DISABLE_IMAGE_OPTIMIZATION=false
